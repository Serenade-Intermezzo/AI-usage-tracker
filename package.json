{
  "name": "ai-usage-tracker",
  "private": true,
  "version": "0.2.2",
  "type": "module",
  "scripts": {
    "build": "node scripts/build.mjs",
    "build:native": "node scripts/build.mjs",
    "start": "node dist-server/index.js",
    "dev": "tsx watch server/index.ts",
    "test": "tsx --test server/tests.ts",
    "typecheck": "tsc -p tsconfig.server.json --noEmit"
  },
  "dependencies": {
    "dotenv": "^17.2.2",
    "express": "^5.1.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.3",

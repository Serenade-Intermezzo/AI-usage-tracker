# Native Codex token tracker. Copy to .env on Linux before installing the service.
# GUI > 设置 writes DATA_DIR/installation.json, which takes precedence for
# role/member/connection/host settings. Never commit .env or the data directory.
# Native rendering, account scoping and local-only metering are enforced.
TRACKER_ROLE=standalone
HOST=127.0.0.1
PORT=8893
CODEX=true
CODEX_SCAN=true
WATCH_SESSIONS=true

# Defaults to ./data. Choose a new, private directory for each installation.
# DATA_DIR=
# Codex Desktop and CLI homes are discovered automatically unless overridden.
# CODEX_HOME=
# CODEX_EXTRA_HOMES=   # ':' separated on Linux; ';' separated on Windows

# Prefer native GUI setup: create a hub, add members, generate an invitation,
# then paste that member's invitation on every device belonging to them.
# Advanced/headless setup only:
# TRACKER_ROLE=server
# CODEX_SCAN=false
# TEAM_ACCOUNT_FINGERPRINT=   # 64-character non-secret account SHA256
# SYNC_SECRET=               # private shared team key; at least 32 random bytes
# HOST=0.0.0.0               # enable network access only when needed
# MEMBER_ID=owner
# MEMBER_NAME=My name
# DEVICE_ID=my-unique-device
# DEVICE_LABEL=My laptop
# Collectors additionally require CENTRAL_URL and MEMBER_ID registered on hub:
# CENTRAL_URL=http://192.168.1.10:8893

# Optional timing in milliseconds:
# SESSION_SCAN_MS=120000
# SYNC_BATCH_SIZE=500
# SYNC_DEBOUNCE_MS=2500
# SYNC_HEARTBEAT_MS=90000
# SYNC_MAX_BACKOFF_MS=300000
